{
  "name": "forgedefender",
  "displayName": "ForgeDefender",
  "description": "Tests, coverage, gas, traces, deploys and security checks for Foundry and Anchor, with keymoat keeping your keys out of reach.",
  "version": "2.0.0",
  "publisher": "ChainDefenders",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chain-Defenders/forge-defender"
  },
  "homepage": "https://github.com/Chain-Defenders/forge-defender#readme",
  "engines": {
    "vscode": "^1.91.0"
  },
  "icon": "media/forge-defender-logo.png",
  "categories": [
    "Testing",
    "Debuggers",
    "Linters",
    "Other"
  ],
  "keywords": [
    "foundry",
    "forge",
    "anchor",
    "solana",
    "solidity",
    "testing",
    "coverage",
    "gas",
    "security",
    "web3",
    "smart contracts",
    "ethereum"
  ],
  "activationEvents": [
    "workspaceContains:**/foundry.toml",
    "workspaceContains:**/Anchor.toml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgeDefender",
          "title": "ForgeDefender",
          "icon": "media/activity.svg"
        }
      ]
    },
    "configuration": {
      "title": "ForgeDefender",
      "properties": {
        "forgeDefender.paths.forge": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `forge`. Empty: `forge` from the PATH, which goes through keymoat when it is installed."
        },
        "forgeDefender.paths.cast": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `cast`. Empty: from the PATH."
        },
        "forgeDefender.paths.anvil": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `anvil`. Empty: from the PATH."
        },
        "forgeDefender.paths.anchor": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `anchor`. Empty: from the PATH."
        },
        "forgeDefender.paths.solana": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `solana`. Empty: from the PATH."
        },
        "forgeDefender.paths.solana-test-validator": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `solana-test-validator`. Empty: from the PATH."
        },
        "forgeDefender.paths.keymoat": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `keymoat`. Empty: from the PATH."
        },
        "forgeDefender.paths.slither": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `slither`. Empty: from the PATH."
        },
        "forgeDefender.paths.aderyn": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `aderyn`. Empty: from the PATH."
        },
        "forgeDefender.tests.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments for `forge test`, such as `[\"--ffi\"]` or `[\"--fork-url\", \"mainnet\"]`."
        },
        "forgeDefender.coverage.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments for `forge coverage`. Add `--ir-minimum` if coverage fails with \"stack too deep\"."
        },
        "forgeDefender.gas.showInline": {
          "type": "boolean",
          "default": true,
          "description": "Show each test's gas at the end of its line after a run."
        },
        "forgeDefender.gas.warnPercent": {
          "type": "number",
          "default": 1,
          "markdownDescription": "Highlight a test whose gas rose by more than this percentage over `.gas-snapshot`."
        }
      }
    },
    "commands": [
      {
        "command": "forgeDefender.tests.addRegression",
        "title": "Add as Regression Test",
        "category": "ForgeDefender",
        "icon": "$(debug-restart)"
      },
      {
        "command": "forgeDefender.tests.updateSnapshot",
        "title": "Update Gas Snapshot",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.coverage.run",
        "title": "Measure Coverage",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.trace.show",
        "title": "Show Call Trace",
        "category": "ForgeDefender",
        "icon": "$(list-tree)"
      }
    ],
    "views": {
      "forgeDefender": [
        {
          "id": "forgeDefender.trace",
          "name": "Trace",
          "when": "forgeDefender.trace.has"
        }
      ]
    },
    "menus": {
      "testing/item/context": [
        {
          "command": "forgeDefender.trace.show",
          "when": "controllerId == forgeDefender.foundry && !testing.testItemHasChildren",
          "group": "forgeDefender@1"
        },
        {
          "command": "forgeDefender.tests.addRegression",
          "when": "controllerId == forgeDefender.foundry && !testing.testItemHasChildren",
          "group": "forgeDefender@2"
        }
      ],
      "testing/message/context": [
        {
          "command": "forgeDefender.tests.addRegression",
          "when": "testMessage == forgeDefender.counterexample",
          "group": "forgeDefender@1"
        },
        {
          "command": "forgeDefender.trace.show",
          "when": "testMessage =~ /^forgeDefender\\./",
          "group": "forgeDefender@2"
        }
      ],
      "testing/message/content": [
        {
          "command": "forgeDefender.tests.addRegression",
          "when": "testMessage == forgeDefender.counterexample"
        },
        {
          "command": "forgeDefender.trace.show",
          "when": "testMessage =~ /^forgeDefender\\./"
        }
      ],
      "commandPalette": [
        {
          "command": "forgeDefender.tests.addRegression",
          "when": "false"
        },
        {
          "command": "forgeDefender.trace.show",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "contrib": "node scripts/contrib.mjs",
    "build": "node scripts/contrib.mjs && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "test:unit": "tsc -p . && mocha --ui tdd 'out/test/unit/**/*.test.js'",
    "test:vscode": "tsc -p . && node scripts/build.mjs && node out/test/vscode/run.js",
    "test": "npm run test:unit && npm run test:vscode",
    "package": "npm run build && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.25.12",
    "mocha": "11.7.5",
    "typescript": "5.9.3"
  }
}
