{
  "name": "forgedefender",
  "displayName": "ForgeDefender",
  "description": "Tests, coverage, gas, traces, deploys and security checks for Foundry and Anchor.",
  "version": "2.0.1",
  "publisher": "ChainDefenders",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chain-Defenders/forge-defender"
  },
  "homepage": "https://github.com/Chain-Defenders/forge-defender#readme",
  "engines": {
    "vscode": "^1.91.0"
  },
  "icon": "media/forge-defender-logo.png",
  "categories": [
    "Testing",
    "Debuggers",
    "Linters",
    "Other"
  ],
  "keywords": [
    "foundry",
    "forge",
    "anchor",
    "solana",
    "solidity",
    "testing",
    "coverage",
    "gas",
    "security",
    "web3",
    "smart contracts",
    "ethereum"
  ],
  "activationEvents": [
    "workspaceContains:**/foundry.toml",
    "workspaceContains:**/Anchor.toml",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgeDefender",
          "title": "ForgeDefender",
          "icon": "media/activity.svg"
        }
      ]
    },
    "configuration": {
      "title": "ForgeDefender",
      "properties": {
        "forgeDefender.projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "resource",
          "markdownDescription": "Project folders to use instead of searching the workspace, relative to the workspace folder or absolute. A folder with an `Anchor.toml` is an Anchor project; any other is a Foundry project, run with forge's defaults when it has no `foundry.toml`. Empty: every folder with a `foundry.toml` or `Anchor.toml` is found, at any depth."
        },
        "forgeDefender.paths.forge": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `forge`. Empty: `forge` from the PATH, which goes through KeyMoat when it is installed."
        },
        "forgeDefender.paths.cast": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `cast`. Empty: from the PATH."
        },
        "forgeDefender.paths.anvil": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `anvil`. Empty: from the PATH."
        },
        "forgeDefender.paths.anchor": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `anchor`. Empty: from the PATH."
        },
        "forgeDefender.paths.solana": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `solana`. Empty: from the PATH."
        },
        "forgeDefender.paths.solana-test-validator": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `solana-test-validator`. Empty: from the PATH."
        },
        "forgeDefender.paths.keymoat": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `keymoat`. Empty: from the PATH."
        },
        "forgeDefender.paths.slither": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `slither`. Empty: from the PATH."
        },
        "forgeDefender.paths.aderyn": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `aderyn`. Empty: from the PATH."
        },
        "forgeDefender.chain.port": {
          "type": "integer",
          "default": 8545,
          "minimum": 1,
          "maximum": 65535,
          "markdownDescription": "Port for the local Anvil chain: where the Local chain view starts it and looks for it."
        },
        "forgeDefender.sizes.afterTests": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Check contract sizes against the EIP-170 and EIP-3860 limits after each `forge test` run."
        },
        "forgeDefender.tests.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments for `forge test`, such as `[\"--ffi\"]` or `[\"--fork-url\", \"mainnet\"]`."
        },
        "forgeDefender.coverage.extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments for `forge coverage`. Add `--ir-minimum` if coverage fails with \"stack too deep\"."
        },
        "forgeDefender.gas.showInline": {
          "type": "boolean",
          "default": true,
          "description": "Show each test's gas at the end of its line after a run."
        },
        "forgeDefender.gas.warnPercent": {
          "type": "number",
          "default": 1,
          "markdownDescription": "Highlight a test whose gas rose by more than this percentage over `.gas-snapshot`."
        },
        "forgeDefender.security.analysis.engine": {
          "type": "string",
          "enum": [
            "auto",
            "slither",
            "aderyn"
          ],
          "enumDescriptions": [
            "Slither when installed, otherwise Aderyn.",
            "Always Slither.",
            "Always Aderyn."
          ],
          "default": "auto",
          "markdownDescription": "Static analyser for **Run Static Analysis**."
        },
        "forgeDefender.security.analysis.onSave": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Run static analysis on the project each time a Solidity file is saved."
        },
        "forgeDefender.security.storage.checkAfterTests": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "After each `forge test` run, check storage layouts against the baselines in `.forgedefender/storage`, when there are any."
        },
        "forgeDefender.security.storage.codeLens": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Show storage baseline actions above contracts that look upgradeable."
        },
        "forgeDefender.anchor.testArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments for `anchor test` when tests run from the Testing view, for example `--skip-build`. Runs that would deploy to a cluster other than localnet are not started from here."
        },
        "forgeDefender.solana.computeUnitWarning": {
          "type": "number",
          "default": 100000,
          "minimum": 0,
          "markdownDescription": "Instructions that used more compute units than this in the last test run are flagged in the Solana view. The default budget per instruction is 200,000."
        }
      }
    },
    "views": {
      "forgeDefender": [
        {
          "id": "forgeDefender.keymoat",
          "name": "KeyMoat",
          "when": "forgeDefender.hasProjects"
        },
        {
          "id": "forgeDefender.chain",
          "name": "Local chain",
          "when": "forgeDefender.hasProjects"
        },
        {
          "id": "forgeDefender.deployments",
          "name": "Deployments",
          "when": "forgeDefender.hasProjects"
        },
        {
          "id": "forgeDefender.trace",
          "name": "Trace",
          "when": "forgeDefender.hasProjects && forgeDefender.trace.has"
        },
        {
          "id": "forgeDefender.security.dependencies",
          "name": "Dependencies",
          "when": "forgeDefender.hasProjects"
        },
        {
          "id": "forgeDefender.security.readiness",
          "name": "Audit Readiness",
          "when": "forgeDefender.hasProjects"
        },
        {
          "id": "forgeDefender.solana",
          "name": "Solana",
          "when": "forgeDefender.hasProjects && forgeDefender.anchorProjects"
        }
      ]
    },
    "commands": [
      {
        "command": "forgeDefender.keymoat.refresh",
        "title": "Refresh KeyMoat status",
        "category": "ForgeDefender",
        "icon": "$(refresh)"
      },
      {
        "command": "forgeDefender.keymoat.openKey",
        "title": "Open where the key is",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.keymoat.moveKey",
        "title": "Move into encrypted storage",
        "category": "ForgeDefender",
        "icon": "$(lock)"
      },
      {
        "command": "forgeDefender.keymoat.allowHost",
        "title": "Allow this host",
        "category": "ForgeDefender",
        "icon": "$(check)"
      },
      {
        "command": "forgeDefender.keymoat.useLinks",
        "title": "Run ForgeDefender's tools through KeyMoat",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.keymoat.openDocs",
        "title": "About KeyMoat",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.chain.start",
        "title": "Start Anvil",
        "category": "ForgeDefender",
        "icon": "$(play)"
      },
      {
        "command": "forgeDefender.chain.startFork",
        "title": "Fork a network with Anvil",
        "category": "ForgeDefender",
        "icon": "$(repo-forked)"
      },
      {
        "command": "forgeDefender.chain.stop",
        "title": "Stop Anvil",
        "category": "ForgeDefender",
        "icon": "$(debug-stop)"
      },
      {
        "command": "forgeDefender.chain.reset",
        "title": "Reset the local chain",
        "category": "ForgeDefender",
        "icon": "$(discard)"
      },
      {
        "command": "forgeDefender.chain.refresh",
        "title": "Refresh local chain status",
        "category": "ForgeDefender",
        "icon": "$(refresh)"
      },
      {
        "command": "forgeDefender.chain.copyAddress",
        "title": "Copy address",
        "category": "ForgeDefender",
        "icon": "$(copy)"
      },
      {
        "command": "forgeDefender.chain.startSolana",
        "title": "Start the Solana test validator",
        "category": "ForgeDefender",
        "icon": "$(play)"
      },
      {
        "command": "forgeDefender.chain.stopSolana",
        "title": "Stop the Solana test validator",
        "category": "ForgeDefender",
        "icon": "$(debug-stop)"
      },
      {
        "command": "forgeDefender.deployments.refresh",
        "title": "Refresh deployments",
        "category": "ForgeDefender",
        "icon": "$(refresh)"
      },
      {
        "command": "forgeDefender.deployments.copyAddress",
        "title": "Copy address",
        "category": "ForgeDefender",
        "icon": "$(copy)"
      },
      {
        "command": "forgeDefender.deployments.copyTx",
        "title": "Copy transaction hash",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.deployments.openExplorer",
        "title": "Open in block explorer",
        "category": "ForgeDefender",
        "icon": "$(link-external)"
      },
      {
        "command": "forgeDefender.deployments.verify",
        "title": "Verify source on the explorer",
        "category": "ForgeDefender",
        "icon": "$(verified)"
      },
      {
        "command": "forgeDefender.deploy.dryRun",
        "title": "Dry run a script",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.deploy.script",
        "title": "Deploy with a script…",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.deploy.anchor",
        "title": "Deploy the Anchor program…",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.sizes.check",
        "title": "Check contract sizes",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.selectors.decode",
        "title": "Decode calldata or revert data",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.tests.addRegression",
        "title": "Add as Regression Test",
        "category": "ForgeDefender",
        "icon": "$(debug-restart)"
      },
      {
        "command": "forgeDefender.tests.updateSnapshot",
        "title": "Update Gas Snapshot",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.coverage.run",
        "title": "Measure Coverage",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.trace.show",
        "title": "Show Call Trace",
        "category": "ForgeDefender",
        "icon": "$(list-tree)"
      },
      {
        "command": "forgeDefender.security.showStorageLayout",
        "title": "Show Storage Layout",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.security.saveStorageBaseline",
        "title": "Save Storage Baseline",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.security.checkStorageLayouts",
        "title": "Check Storage Layouts Against Baselines",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.security.checkDependencies",
        "title": "Check Dependencies for Known Advisories",
        "category": "ForgeDefender",
        "icon": "$(refresh)"
      },
      {
        "command": "forgeDefender.security.runAnalysis",
        "title": "Run Static Analysis",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.security.clearAnalysis",
        "title": "Clear Static Analysis Findings",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.security.auditReadiness",
        "title": "Show Audit Readiness Report",
        "category": "ForgeDefender",
        "icon": "$(preview)"
      },
      {
        "command": "forgeDefender.security.writeScope",
        "title": "Write scope.txt",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.security.refreshReadiness",
        "title": "Refresh Audit Readiness",
        "category": "ForgeDefender",
        "icon": "$(refresh)"
      },
      {
        "command": "forgeDefender.security.readinessCoverage",
        "title": "Run Coverage for Audit Readiness",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.security.openLocation",
        "title": "Open Location",
        "category": "ForgeDefender"
      },
      {
        "command": "forgeDefender.solana.refresh",
        "title": "Refresh Solana View",
        "category": "ForgeDefender",
        "icon": "$(refresh)"
      },
      {
        "command": "forgeDefender.solana.findPda",
        "title": "Find Program Derived Address (PDA)",
        "category": "ForgeDefender",
        "icon": "$(key)"
      },
      {
        "command": "forgeDefender.solana.openIdl",
        "title": "Open IDL File",
        "category": "ForgeDefender",
        "icon": "$(go-to-file)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "forgeDefender.keymoat.openKey",
          "when": "false"
        },
        {
          "command": "forgeDefender.keymoat.moveKey",
          "when": "false"
        },
        {
          "command": "forgeDefender.keymoat.allowHost",
          "when": "false"
        },
        {
          "command": "forgeDefender.chain.copyAddress",
          "when": "false"
        },
        {
          "command": "forgeDefender.chain.startSolana",
          "when": "forgeDefender.chain.solana"
        },
        {
          "command": "forgeDefender.chain.stopSolana",
          "when": "forgeDefender.chain.solana"
        },
        {
          "command": "forgeDefender.deployments.copyAddress",
          "when": "false"
        },
        {
          "command": "forgeDefender.deployments.copyTx",
          "when": "false"
        },
        {
          "command": "forgeDefender.deployments.openExplorer",
          "when": "false"
        },
        {
          "command": "forgeDefender.deployments.verify",
          "when": "false"
        },
        {
          "command": "forgeDefender.tests.addRegression",
          "when": "false"
        },
        {
          "command": "forgeDefender.trace.show",
          "when": "false"
        },
        {
          "command": "forgeDefender.security.openLocation",
          "when": "false"
        },
        {
          "command": "forgeDefender.security.readinessCoverage",
          "when": "false"
        },
        {
          "command": "forgeDefender.security.refreshReadiness",
          "when": "false"
        },
        {
          "command": "forgeDefender.security.showStorageLayout",
          "when": "resourceExtname == .sol"
        },
        {
          "command": "forgeDefender.security.saveStorageBaseline",
          "when": "resourceExtname == .sol"
        },
        {
          "command": "forgeDefender.solana.openIdl",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "forgeDefender.keymoat.refresh",
          "when": "view == forgeDefender.keymoat",
          "group": "navigation"
        },
        {
          "command": "forgeDefender.chain.start",
          "when": "view == forgeDefender.chain && !forgeDefender.chain.running",
          "group": "navigation@1"
        },
        {
          "command": "forgeDefender.chain.startFork",
          "when": "view == forgeDefender.chain && !forgeDefender.chain.running",
          "group": "navigation@2"
        },
        {
          "command": "forgeDefender.chain.stop",
          "when": "view == forgeDefender.chain && forgeDefender.chain.running && forgeDefender.chain.ours",
          "group": "navigation@1"
        },
        {
          "command": "forgeDefender.chain.reset",
          "when": "view == forgeDefender.chain && forgeDefender.chain.running",
          "group": "navigation@2"
        },
        {
          "command": "forgeDefender.chain.refresh",
          "when": "view == forgeDefender.chain",
          "group": "navigation@3"
        },
        {
          "command": "forgeDefender.deployments.refresh",
          "when": "view == forgeDefender.deployments",
          "group": "navigation"
        },
        {
          "command": "forgeDefender.security.checkDependencies",
          "when": "view == forgeDefender.security.dependencies",
          "group": "navigation"
        },
        {
          "command": "forgeDefender.security.auditReadiness",
          "when": "view == forgeDefender.security.readiness",
          "group": "navigation@1"
        },
        {
          "command": "forgeDefender.security.refreshReadiness",
          "when": "view == forgeDefender.security.readiness",
          "group": "navigation@2"
        },
        {
          "command": "forgeDefender.solana.findPda",
          "when": "view == forgeDefender.solana",
          "group": "navigation@1"
        },
        {
          "command": "forgeDefender.solana.refresh",
          "when": "view == forgeDefender.solana",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "forgeDefender.keymoat.allowHost",
          "when": "view == forgeDefender.keymoat && viewItem == keymoatHost",
          "group": "inline"
        },
        {
          "command": "forgeDefender.keymoat.allowHost",
          "when": "view == forgeDefender.keymoat && viewItem == keymoatHost"
        },
        {
          "command": "forgeDefender.keymoat.moveKey",
          "when": "view == forgeDefender.keymoat && viewItem == keymoatKey.movable",
          "group": "inline"
        },
        {
          "command": "forgeDefender.keymoat.moveKey",
          "when": "view == forgeDefender.keymoat && viewItem == keymoatKey.movable"
        },
        {
          "command": "forgeDefender.chain.copyAddress",
          "when": "view == forgeDefender.chain && viewItem == chainAccount",
          "group": "inline"
        },
        {
          "command": "forgeDefender.chain.startSolana",
          "when": "view == forgeDefender.chain && viewItem == solanaNode.stopped",
          "group": "inline"
        },
        {
          "command": "forgeDefender.chain.stopSolana",
          "when": "view == forgeDefender.chain && viewItem == solanaNode.ours",
          "group": "inline"
        },
        {
          "command": "forgeDefender.deployments.openExplorer",
          "when": "view == forgeDefender.deployments && viewItem =~ /\\.explorer/",
          "group": "inline@1"
        },
        {
          "command": "forgeDefender.deployments.verify",
          "when": "view == forgeDefender.deployments && viewItem =~ /\\.verifiable/",
          "group": "inline@2"
        },
        {
          "command": "forgeDefender.deployments.copyAddress",
          "when": "view == forgeDefender.deployments && viewItem =~ /^deployment/",
          "group": "1_copy@1"
        },
        {
          "command": "forgeDefender.deployments.copyTx",
          "when": "view == forgeDefender.deployments && viewItem =~ /^deployment/",
          "group": "1_copy@2"
        },
        {
          "command": "forgeDefender.deployments.openExplorer",
          "when": "view == forgeDefender.deployments && viewItem =~ /\\.explorer/",
          "group": "2_open@1"
        },
        {
          "command": "forgeDefender.deployments.verify",
          "when": "view == forgeDefender.deployments && viewItem =~ /\\.verifiable/",
          "group": "2_open@2"
        },
        {
          "command": "forgeDefender.solana.openIdl",
          "when": "view == forgeDefender.solana && viewItem == idl",
          "group": "inline"
        }
      ],
      "testing/item/context": [
        {
          "command": "forgeDefender.trace.show",
          "when": "controllerId == forgeDefender.foundry && !testing.testItemHasChildren",
          "group": "forgeDefender@1"
        },
        {
          "command": "forgeDefender.tests.addRegression",
          "when": "controllerId == forgeDefender.foundry && !testing.testItemHasChildren",
          "group": "forgeDefender@2"
        }
      ],
      "testing/message/context": [
        {
          "command": "forgeDefender.tests.addRegression",
          "when": "testMessage == forgeDefender.counterexample",
          "group": "forgeDefender@1"
        },
        {
          "command": "forgeDefender.trace.show",
          "when": "testMessage =~ /^forgeDefender\\./",
          "group": "forgeDefender@2"
        }
      ],
      "testing/message/content": [
        {
          "command": "forgeDefender.tests.addRegression",
          "when": "testMessage == forgeDefender.counterexample"
        },
        {
          "command": "forgeDefender.trace.show",
          "when": "testMessage =~ /^forgeDefender\\./"
        }
      ],
      "editor/context": [
        {
          "command": "forgeDefender.security.showStorageLayout",
          "when": "resourceExtname == .sol",
          "group": "forgeDefender@40"
        }
      ]
    }
  },
  "scripts": {
    "contrib": "node scripts/contrib.mjs",
    "build": "node scripts/contrib.mjs && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "test:unit": "tsc -p . && mocha --ui tdd 'out/test/unit/**/*.test.js'",
    "test:vscode": "tsc -p . && node scripts/build.mjs && node out/test/vscode/run.js",
    "test": "npm run test:unit && npm run test:vscode",
    "package": "npm run build && vsce package --no-dependencies --githubBranch v2",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.25.12",
    "mocha": "11.7.5",
    "typescript": "5.9.3"
  }
}
