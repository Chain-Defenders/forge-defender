{
  "name": "forgedefender",
  "displayName": "ForgeDefender",
  "description": "Tests, coverage, gas, traces, deploys and security checks for Foundry and Anchor, with keymoat keeping your keys out of reach.",
  "version": "2.0.0",
  "publisher": "ChainDefenders",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Chain-Defenders/forge-defender"
  },
  "homepage": "https://github.com/Chain-Defenders/forge-defender#readme",
  "engines": {
    "vscode": "^1.91.0"
  },
  "icon": "media/forge-defender-logo.png",
  "categories": [
    "Testing",
    "Debuggers",
    "Linters",
    "Other"
  ],
  "keywords": [
    "foundry",
    "forge",
    "anchor",
    "solana",
    "solidity",
    "testing",
    "coverage",
    "gas",
    "security",
    "web3",
    "smart contracts",
    "ethereum"
  ],
  "activationEvents": [
    "workspaceContains:**/foundry.toml",
    "workspaceContains:**/Anchor.toml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgeDefender",
          "title": "ForgeDefender",
          "icon": "media/activity.svg"
        }
      ]
    },
    "configuration": {
      "title": "ForgeDefender",
      "properties": {
        "forgeDefender.paths.forge": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `forge`. Empty: `forge` from the PATH, which goes through keymoat when it is installed."
        },
        "forgeDefender.paths.cast": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `cast`. Empty: from the PATH."
        },
        "forgeDefender.paths.anvil": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `anvil`. Empty: from the PATH."
        },
        "forgeDefender.paths.anchor": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `anchor`. Empty: from the PATH."
        },
        "forgeDefender.paths.solana": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `solana`. Empty: from the PATH."
        },
        "forgeDefender.paths.solana-test-validator": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `solana-test-validator`. Empty: from the PATH."
        },
        "forgeDefender.paths.keymoat": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `keymoat`. Empty: from the PATH."
        },
        "forgeDefender.paths.slither": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `slither`. Empty: from the PATH."
        },
        "forgeDefender.paths.aderyn": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to `aderyn`. Empty: from the PATH."
        },
        "forgeDefender.anchor.testArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Extra arguments for `anchor test` when tests run from the Testing view, for example `--skip-build`. Runs that would deploy to a cluster other than localnet are not started from here."
        },
        "forgeDefender.solana.computeUnitWarning": {
          "type": "number",
          "default": 100000,
          "minimum": 0,
          "markdownDescription": "Instructions that used more compute units than this in the last test run are flagged in the Solana view. The default budget per instruction is 200,000."
        }
      }
    },
    "commands": [
      {
        "command": "forgeDefender.solana.refresh",
        "title": "Refresh Solana View",
        "category": "ForgeDefender",
        "icon": "$(refresh)"
      },
      {
        "command": "forgeDefender.solana.findPda",
        "title": "Find Program Derived Address (PDA)",
        "category": "ForgeDefender",
        "icon": "$(key)"
      },
      {
        "command": "forgeDefender.solana.openIdl",
        "title": "Open IDL File",
        "category": "ForgeDefender",
        "icon": "$(go-to-file)"
      }
    ],
    "views": {
      "forgeDefender": [
        {
          "id": "forgeDefender.solana",
          "name": "Solana",
          "when": "forgeDefender.anchorProjects"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "forgeDefender.solana.findPda",
          "when": "view == forgeDefender.solana",
          "group": "navigation@1"
        },
        {
          "command": "forgeDefender.solana.refresh",
          "when": "view == forgeDefender.solana",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "forgeDefender.solana.openIdl",
          "when": "view == forgeDefender.solana && viewItem == idl",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "forgeDefender.solana.openIdl",
          "when": "false"
        }
      ]
    }
  },
  "scripts": {
    "contrib": "node scripts/contrib.mjs",
    "build": "node scripts/contrib.mjs && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc -p . --noEmit",
    "test:unit": "tsc -p . && mocha --ui tdd 'out/test/unit/**/*.test.js'",
    "test:vscode": "tsc -p . && node scripts/build.mjs && node out/test/vscode/run.js",
    "test": "npm run test:unit && npm run test:vscode",
    "package": "npm run build && vsce package --no-dependencies",
    "vscode:prepublish": "npm run build"
  },
  "dependencies": {
    "@noble/curves": "1.9.7",
    "@noble/hashes": "1.8.0"
  },
  "devDependencies": {
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "@types/vscode": "1.91.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "3.6.2",
    "esbuild": "0.25.12",
    "mocha": "11.7.5",
    "typescript": "5.9.3"
  }
}
